  "date_sensitive_docs": [
    "register",
    "checklist",
    "sow",
    "tender_analysis"
  ],
  "ignore_docs": [],
  "stale_ok": [],
  "skills": {
    "register_review": "invero-pm:tender-documentation-review",
    "register_initial": "invero-pm:tender-documentation-review",
    "register_style": "invero-pm:concise-register-entries",
