{
  "schema_version": 3,
  "project_facts": {
    "country": null,
    "region": null,
    "address": null,
    "client": null,
    "role": "consultant project manager acting for the client",
    "authority_having_jurisdiction": null,
    "building_code": null,
    "payment_law": null,
    "payment_periods": {},
    "safety_regime": null,
    "contract_form": null,
    "contract_periods": {}
  },
  "terminology": {},
  "aliases": [],
  "ignore_files": [
    "Thumbs.db",
    "desktop.ini",
    ".DS_Store"
  ],
  "ignore_prefixes": [
    "~$"
  ],
  "skip_dirs": [
    "CADs",
    "CAD",
    "LINKEDs",
    "_SS",
    "SS",
    "pages-to-jpg"
  ],
  "drawings": {
    "dir": "Drawings",
    "stages": [
      {
        "folder": "1. Existing",
        "stage": "existing",
        "is_issue": false
      },
      {
        "folder": "2. Preliminary Issue",
        "stage": "preliminary"
      },
      {
        "folder": "3. Tender Issue",
        "stage": "tender"
      },
      {
        "folder": "4. Construction Issue",
        "stage": "construction"
      },
      {
        "folder": "5. As Built",
        "stage": "as_built"
      }
    ],
    "tender_stage": "tender",
    "skip_folders": [],
    "pinned_set_pattern": null,
    "expected_disciplines": [
      "architectural",
      "structural",
      "mechanical",
      "electrical",
      "hydraulic",
      "fire"
    ],
    "discipline_prefixes": {
      "A": "architectural",
      "S": "structural",
      "M": "mechanical",
      "E": "electrical",
      "H": "hydraulic",
      "F": "fire"
    }
  },
  "registers": {
    "dirs": [
      "Tender",
      "Drawings/3. Tender Issue"
    ],
    "exts": [
      ".xlsx",
      ".xlsm"
    ],
    "pattern": "clarific|register",
    "exclude": "subcontractor"
  },
  "documents": {
    "sow": {
      "find": [
        {
          "dir": "Tender",
          "exts": [
            ".docx",
            ".doc"
          ],
          "pattern": "scope[ _]*of[ _]*works|\\bsow\\b"
        },
        {
          "dir": "Tender",
          "exts": [
            ".docx"
          ],
          "pattern": "scope"
        }
      ]
    },
    "checklist": {
      "find": [
        {
          "dir": "Checklists",
          "exts": [
            ".docx",
            ".xlsx"
          ],
          "pattern": "checklist"
        }
      ]
    },
    "tender_analysis": {
      "find": [
        {
          "dir": "Finance",
          "exts": [
            ".xlsx",
            ".pdf"
          ],
          "pattern": "tender[ _]*analysis|cost[ _]*comparison"
        },
        {
          "dir": "Tender",
          "exts": [
            ".xlsx",
            ".pdf"
          ],
          "pattern": "tender[ _]*analysis|cost[ _]*comparison"
        }
      ]
    },
    "site_survey": {
      "folder": [
        "Site Survey"
      ]
    },
    "permits": {
      "folder": [
        "Certificates & Permits"
      ]
    },
    "safety": {
      "folder": [
        "Safety"
      ]
    },
    "operation_manual": {
      "folder": [
        "Operation Manual"
      ]
    },
    "trade_contract": {
      "find": [
        {
          "dir": "Finance",
          "exts": [
            ".pdf",
            ".docx",
            ".doc"
          ],
          "pattern": "trade[ _]*contract|contract[ _]*executed"
        }
      ]
    },
    "handover_report": {
      "find": [
        {
          "dir": "Defects",
          "exts": [
            ".xlsx",
            ".pdf"
          ],
          "pattern": "handover"
        }
      ]
    }
  },
  "programme": {
    "dir": "Programme",
    "exts": [
      ".pdf",
      ".mpp"
    ],
    "milestone": "Practical completion"
  },
  "budget": {
    "dir": "Finance",
    "file_pattern": "budget|cost plan",
    "labels": {
      "total": [
        "total project cost",
        "total budget"
      ],
      "contract_sum": [
        "contract sum",
        "head contract"
      ],
      "area": [
        "total sqm",
        "total area",
        "gfa"
      ]
    },
    "count_dirs": {
      "invoices": "Invoices",
      "purchase_orders": "Purchase Orders",
      "quotes": "Quotes"
    }
  },
  "evidence_register": null,
  "required_documents": {
    "preliminary": [
      "drawing_set",
      "register",
      "checklist",
      "program",
      "site_survey",
      "budget"
    ],
    "tender": [
      "drawing_set",
      "register",
      "checklist",
      "sow",
      "tender_analysis",
      "program",
      "site_survey",
      "budget",
      "permits"
